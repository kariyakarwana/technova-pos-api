NODE_ENV="development"
PORT="4000"
FRONTEND_URL="http://localhost:3000"

DATABASE_URL="postgresql://postgres:replace-me@localhost:5432/technova_pos?schema=public"

# Generate independent, high-entropy secrets for each environment.
JWT_ACCESS_PRIVATE_KEY="replace-with-at-least-32-random-bytes"
JWT_ACCESS_PUBLIC_KEY="replace-with-the-corresponding-verification-key"
AUTH_OTP_PEPPER="replace-with-a-different-random-secret"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-google-app-password"
SMTP_FROM="TechNova POS <your-email@gmail.com>"

# Meta WhatsApp Cloud API (server-side values only).
WHATSAPP_ACCESS_TOKEN="your-system-user-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
WHATSAPP_GRAPH_API_VERSION="v23.0"
WHATSAPP_WEBHOOK_SECRET="replace-with-a-random-webhook-signing-secret"
NOTIFICATION_WORKER_ENABLED="false"
QR_LABEL_SECRET="replace-with-at-least-32-random-characters"

# Initial WhatsApp provider (use "whatchimp" or "meta")
WHATSAPP_PROVIDER="whatchimp"
WHATCHIMP_API_BASE_URL="https://app.whatchimp.com/api/v1"
WHATCHIMP_API_TOKEN="your-whatchimp-api-token"
WHATCHIMP_PHONE_NUMBER_ID="your-whatchimp-phone-number-id"
WHATCHIMP_TEMPLATE_NAME="technova_pos_update_v1"
WHATCHIMP_LANGUAGE_CODE="en_US"

# Used only by `npx prisma db seed`.
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="Replace!WithStrongPassword2026"
