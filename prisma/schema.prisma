// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierResponseStatus {
  ACCEPTED
  CHANGES_PROPOSED
  REJECTED
  CLARIFICATION_REQUESTED
}

enum SupplierResponseReviewStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum SupplierShipmentStatus {
  PREPARING
  DISPATCHED
  DELIVERED
}

enum StockMovementType {
  PURCHASE_RECEIPT
  SALE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum InventoryUnitStatus {
  IN_STOCK
  RESERVED
  SOLD
  RETURNED
  DAMAGED
  LOST
}

enum SaleStatus {
  DRAFT
  COMPLETED
  VOIDED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_WALLET
  CREDIT
  OTHER
  STORE_CREDIT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  VOIDED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  UNIT_PRICE
}

enum CreditStatus {
  ACTIVE
  PAID
  OVERDUE
  DEFAULTED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
}

enum WarrantyStatus {
  PENDING
  ACTIVE
  EXPIRED
  VOIDED
  CLAIMED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  IN_APP
  WEBHOOK
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD_LETTER
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum ReturnResolution {
  ORIGINAL_METHOD
  STORE_CREDIT
  LOYALTY_POINTS
  PRODUCT_EXCHANGE
}

enum TransferStatus {
  DRAFT
  SUBMITTED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum SyncBatchStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
}

enum SyncOperationStatus {
  PENDING
  APPLIED
  REJECTED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  phone         String?
  passwordHash  String?
  image         String?
  emailVerified DateTime?
  status        UserStatus @default(PENDING_VERIFICATION)

  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  sessionVersion     Int       @default(1)
  mustChangePassword Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  authenticators  Authenticator[]
  refreshSessions RefreshSession[]

  roles                     UserRole[]
  securityTokens            SecurityToken[]
  auditEvents               AuditEvent[]
  organizationMemberships   OrganizationUser[]
  branchAssignments         UserBranch[]
  approvedPurchaseOrders    PurchaseOrder[]         @relation("PurchaseOrderApprover")
  createdSales              Sale[]                  @relation("SaleCreator")
  stockMovements            StockMovement[]
  offlineSyncBatches        OfflineSyncBatch[]
  supplierMembership        SupplierUser?
  supplierResponses         SupplierOrderResponse[] @relation("SupplierResponseAuthor")
  reviewedSupplierResponses SupplierOrderResponse[] @relation("SupplierResponseReviewer")
  supplierShipments         SupplierShipment[]      @relation("SupplierShipmentDispatcher")
  appNotifications          AppNotification[]
  dashboards                Dashboard[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Auth.js OAuth account.
// Google account information will be stored here.
model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// Required by the Auth.js Prisma adapter.
// Credentials authentication will still use JWT strategy.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

model RefreshSession {
  id              String    @id @default(cuid())
  userId          String
  tokenHash       String    @unique
  familyId        String
  parentSessionId String?
  ipHash          String?
  userAgent       String?   @db.VarChar(500)
  expiresAt       DateTime
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  revokeReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@index([parentSessionId])
  @@map("refresh_sessions")
}

// Required by the Auth.js Prisma adapter.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
  @@map("verification_tokens")
}

// Supports future passkey/WebAuthn authentication.
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@map("authenticators")
}

// Application-owned verification and password-reset tokens.
// Only the SHA-256 token hash should be stored.
model SecurityToken {
  id        String       @id @default(cuid())
  userId    String
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  // Password-reset OTP support
  otpHash      String?
  attemptCount Int       @default(0)
  verifiedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([purpose, expiresAt])
  @@map("security_tokens")
}

// Persistent baseline rate-limiting data.
model AuthAttempt {
  id           String   @id @default(cuid())
  action       String
  identityHash String
  ipHash       String
  successful   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([action, identityHash, createdAt])
  @@index([action, ipHash, createdAt])
  @@index([createdAt])
  @@map("auth_attempts")
}

model AuditEvent {
  id        String       @id @default(cuid())
  userId    String?
  action    String
  outcome   AuditOutcome
  ipHash    String?
  userAgent String?      @db.VarChar(500)
  metadata  Json?
  createdAt DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([outcome, createdAt])
  @@map("audit_events")
}

model Organization {
  id                    String                 @id @default(cuid())
  name                  String
  registrationNumber    String?                @unique
  phone                 String?
  email                 String?
  address               Json?
  timezone              String                 @default("Asia/Colombo")
  currencyCode          String                 @default("LKR") @db.VarChar(3)
  status                            RecordStatus           @default(ACTIVE)
  supplierPortalEnabled             Boolean                @default(true)
  supplierOrderChangesEnabled       Boolean                @default(true)
  supplierEmailNotificationsEnabled Boolean                @default(true)
  supplierInAppNotificationsEnabled Boolean                @default(true)
  createdAt                         DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  branding              BrandingAsset?
  branches              Branch[]
  users                 OrganizationUser[]
  categories            Category[]
  brands                Brand[]
  products              Product[]
  suppliers             Supplier[]
  customers             Customer[]
  discountRules         DiscountRule[]
  notificationTemplates NotificationTemplate[]
  domainEvents          DomainEvent[]
  appNotifications      AppNotification[]
  dashboards            Dashboard[]
  dashboardTemplates    DashboardTemplate[]
  visualThemes          VisualTheme[]

  @@index([status])
  @@map("organizations")
}

model BrandingAsset {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  logoUrl         String?
  logoObjectKey   String?      @unique
  logoBucket      String?
  logoContentType String?
  logoSizeBytes   Int?
  receiptLogoUrl  String?
  primaryColor    String?      @db.VarChar(20)
  secondaryColor  String?      @db.VarChar(20)
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("branding_assets")
}

model OrganizationUser {
  organizationId String
  userId         String
  joinedAt       DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_users")
}

model Branch {
  id                   String          @id @default(cuid())
  organizationId       String
  code                 String
  name                 String
  phone                String?
  email                String?
  address              Json?
  status               RecordStatus    @default(ACTIVE)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users                UserBranch[]
  stockLevels          StockLevel[]
  inventoryUnits       InventoryUnit[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  sales                Sale[]
  sourceTransfers      StockTransfer[] @relation("TransferSource")
  destinationTransfers StockTransfer[] @relation("TransferDestination")
  stockMovements       StockMovement[]
  dashboards           Dashboard[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("branches")
}

model UserBranch {
  userId     String
  branchId   String
  isDefault  Boolean  @default(false)
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branches")
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  description    String?
  status         RecordStatus @default(ACTIVE)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]   @relation("CategoryTree")
  products       Product[]

  @@unique([organizationId, name])
  @@index([parentId])
  @@map("categories")
}

model Brand {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         RecordStatus @default(ACTIVE)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, name])
  @@map("brands")
}

model Product {
  id                 String              @id @default(cuid())
  organizationId     String
  categoryId         String?
  brandId            String?
  sku                String
  barcode            String?
  name               String
  description        String?
  costPrice          Decimal             @default(0) @db.Decimal(18, 2)
  sellingPrice       Decimal             @db.Decimal(18, 2)
  taxRate            Decimal             @default(0) @db.Decimal(7, 4)
  trackSerials       Boolean             @default(false)
  reorderLevel       Decimal             @default(0) @db.Decimal(18, 3)
  status             RecordStatus        @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand              Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  stockLevels        StockLevel[]
  inventoryUnits     InventoryUnit[]
  purchaseItems      PurchaseOrderItem[]
  receiptItems       GoodsReceiptItem[]
  saleItems          SaleItem[]
  discountRules      DiscountRule[]
  warrantyPolicies   WarrantyPolicy[]
  stockMovements     StockMovement[]
  stockTransferItems StockTransferItem[]
  images             ProductImage[]
  videos             ProductVideo[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, status])
  @@map("products")
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  url          String   @db.VarChar(2000)
  objectKey    String?  @unique
  bucket       String?
  contentType  String?
  sizeBytes    Int?
  originalName String?
  altText      String?  @db.VarChar(240)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

model ProductVideo {
  id           String   @id @default(cuid())
  productId    String   @unique
  url          String   @db.VarChar(2000)
  objectKey    String   @unique
  bucket       String
  contentType  String
  sizeBytes    Int
  originalName String
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_videos")
}

model Supplier {
  id                        String            @id @default(cuid())
  organizationId            String
  code                      String
  name                      String
  contactName               String?
  phone                     String?
  email                     String?
  address                   Json?
  status                    RecordStatus      @default(ACTIVE)
  portalEnabled             Boolean           @default(false)
  allowOrderChanges         Boolean?
  emailNotificationsEnabled Boolean?
  inAppNotificationsEnabled Boolean?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  organization              Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders            PurchaseOrder[]
  users                     SupplierUser[]
  notifications             AppNotification[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("suppliers")
}

model SupplierUser {
  supplierId String
  userId     String   @unique
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([supplierId, userId])
  @@index([supplierId])
  @@map("supplier_users")
}

model PurchaseOrder {
  id                String                  @id @default(cuid())
  branchId          String
  supplierId        String
  orderNumber       String                  @unique
  status            PurchaseOrderStatus     @default(DRAFT)
  expectedAt        DateTime?
  approvedById      String?
  approvedAt        DateTime?
  subtotal          Decimal                 @default(0) @db.Decimal(18, 2)
  discountTotal     Decimal                 @default(0) @db.Decimal(18, 2)
  taxTotal          Decimal                 @default(0) @db.Decimal(18, 2)
  total             Decimal                 @default(0) @db.Decimal(18, 2)
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  branch            Branch                  @relation(fields: [branchId], references: [id])
  supplier          Supplier                @relation(fields: [supplierId], references: [id])
  approvedBy        User?                   @relation("PurchaseOrderApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  items             PurchaseOrderItem[]
  receipts          GoodsReceipt[]
  supplierResponses SupplierOrderResponse[]
  supplierShipments SupplierShipment[]
  supplierInvoices  SupplierInvoice[]

  @@index([branchId, status, createdAt])
  @@index([supplierId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                    String                      @id @default(cuid())
  purchaseOrderId       String
  productId             String
  quantity              Decimal                     @db.Decimal(18, 3)
  receivedQuantity      Decimal                     @default(0) @db.Decimal(18, 3)
  unitCost              Decimal                     @db.Decimal(18, 2)
  discount              Decimal                     @default(0) @db.Decimal(18, 2)
  tax                   Decimal                     @default(0) @db.Decimal(18, 2)
  lineTotal             Decimal                     @db.Decimal(18, 2)
  purchaseOrder         PurchaseOrder               @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product               Product                     @relation(fields: [productId], references: [id])
  receiptItems          GoodsReceiptItem[]
  supplierResponseLines SupplierOrderResponseLine[]

  @@unique([purchaseOrderId, productId])
  @@index([productId])
  @@map("purchase_order_items")
}

model SupplierOrderResponse {
  id                 String                       @id @default(cuid())
  purchaseOrderId    String
  respondedById      String
  reviewedById       String?
  status             SupplierResponseStatus
  reviewStatus       SupplierResponseReviewStatus @default(NOT_REQUIRED)
  notes              String?
  proposedExpectedAt DateTime?
  respondedAt        DateTime                     @default(now())
  reviewedAt         DateTime?
  purchaseOrder      PurchaseOrder                @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  respondedBy        User                         @relation("SupplierResponseAuthor", fields: [respondedById], references: [id])
  reviewedBy         User?                        @relation("SupplierResponseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  lines              SupplierOrderResponseLine[]

  @@index([purchaseOrderId, respondedAt])
  @@index([reviewStatus, respondedAt])
  @@map("supplier_order_responses")
}

model SupplierOrderResponseLine {
  id                  String                @id @default(cuid())
  responseId          String
  purchaseOrderItemId String
  proposedQuantity    Decimal?              @db.Decimal(18, 3)
  proposedUnitCost    Decimal?              @db.Decimal(18, 2)
  note                String?
  response            SupplierOrderResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem     @relation(fields: [purchaseOrderItemId], references: [id])

  @@unique([responseId, purchaseOrderItemId])
  @@index([purchaseOrderItemId])
  @@map("supplier_order_response_lines")
}

model SupplierShipment {
  id              String                 @id @default(cuid())
  purchaseOrderId String
  dispatchedById  String
  status          SupplierShipmentStatus @default(PREPARING)
  carrier         String?
  trackingNumber  String?
  notes           String?
  expectedArrival DateTime?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  purchaseOrder   PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  dispatchedBy    User                   @relation("SupplierShipmentDispatcher", fields: [dispatchedById], references: [id])
  invoices        SupplierInvoice[]

  @@index([purchaseOrderId, createdAt])
  @@index([status, updatedAt])
  @@map("supplier_shipments")
}

model SupplierInvoice {
  id              String            @id @default(cuid())
  purchaseOrderId String
  shipmentId      String?
  invoiceNumber   String
  fileName        String
  mimeType        String
  fileSize        Int
  fileData        Bytes
  uploadedAt      DateTime          @default(now())
  purchaseOrder   PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  shipment        SupplierShipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId, uploadedAt])
  @@map("supplier_invoices")
}

model AppNotification {
  id              String       @id @default(cuid())
  organizationId  String
  recipientUserId String
  supplierId      String?
  eventType       String
  title           String
  message         String
  actionUrl       String?
  readAt          DateTime?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient       User         @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  supplier        Supplier?    @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt, createdAt])
  @@index([organizationId, createdAt])
  @@map("app_notifications")
}

model GoodsReceipt {
  id                    String             @id @default(cuid())
  branchId              String
  purchaseOrderId       String
  receiptNumber         String             @unique
  supplierInvoiceNumber String?
  receivedAt            DateTime           @default(now())
  notes                 String?
  createdAt             DateTime           @default(now())
  branch                Branch             @relation(fields: [branchId], references: [id])
  purchaseOrder         PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  items                 GoodsReceiptItem[]

  @@index([branchId, receivedAt])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String            @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  productId           String
  quantity            Decimal           @db.Decimal(18, 3)
  unitCost            Decimal           @db.Decimal(18, 2)
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  product             Product           @relation(fields: [productId], references: [id])
  inventoryUnits      InventoryUnit[]

  @@index([productId])
  @@map("goods_receipt_items")
}

model StockLevel {
  id               String   @id @default(cuid())
  branchId         String
  productId        String
  quantityOnHand   Decimal  @default(0) @db.Decimal(18, 3)
  quantityReserved Decimal  @default(0) @db.Decimal(18, 3)
  updatedAt        DateTime @updatedAt
  branch           Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@map("stock_levels")
}

model InventoryUnit {
  id                 String              @id @default(cuid())
  branchId           String
  productId          String
  goodsReceiptItemId String?
  serialNumber       String              @unique
  status             InventoryUnitStatus @default(IN_STOCK)
  qrCodeHash         String              @unique
  qrVersion          Int                 @default(1)
  manufacturedAt     DateTime?
  expiresAt          DateTime?
  createdAt          DateTime            @default(now())
