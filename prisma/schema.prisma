// ---------------------------------------------------------------------------
// Dashboard customization models
// ---------------------------------------------------------------------------

// Stores a saved customizable dashboard configuration for an organization.
// Optionally scoped to a specific branch or a specific user.
//
// Ownership design:
//   - organizationId (required): Every dashboard belongs to an organization.
//     This is the primary tenant-isolation boundary enforced server-side.
//   - branchId (optional): When set, the dashboard is branch-specific and
//     displayed for all users of that branch (unless further overridden by userId).
//   - userId (optional): When set, the dashboard is personal — visible only
//     to that user. A user may have multiple named dashboards but at most one
//     isDefault per organization.
//
// onDelete behavior:
//   - Organization: Cascade — if the tenant is deleted all their dashboards go.
//   - Branch: SetNull — if a branch is deleted, the dashboard reverts to
//     organization scope rather than being silently destroyed.
//   - User: SetNull — if a user is deleted, the personal dashboard is
//     orphaned to org scope rather than deleted, preserving layout data.
model Dashboard {
  id             String  @id @default(cuid())
  organizationId String
  branchId       String?
  userId         String?

  name        String
  description String?
  isDefault   Boolean @default(false)

  // JSON configuration blob — stores widget grid positions and settings.
  // Schema (application-enforced, not DB-enforced):
  //   { version: number, columns: number, rowHeight: number,
  //     widgets: Array<{ id, type, title, position: {x,y,w,h}, settings: {} }> }
  layout Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId])
  @@index([organizationId, branchId])
  @@index([organizationId, isDefault])
  @@map("dashboards")
}

// Stores reusable dashboard layout blueprints.
// Templates are always organization-scoped; they are never user- or branch-specific
// because they are designed to be applied across multiple dashboards.
//
// isSystem = true  → shipped with the product (e.g. "Store Manager Overview").
// isSystem = false → created by the organization's own administrators.
//
// onDelete behavior:
//   - Organization: Cascade — templates belong to the tenant.
//
// Unique constraint decision:
//   No composite unique on (organizationId, name) is added. Organizations may
//   create multiple templates with the same name over time (e.g. "My Layout v1",
//   "My Layout v1"). Uniqueness is enforced at the application layer if desired.
model DashboardTemplate {
  id             String @id @default(cuid())
  organizationId String

  name        String
  description String?
  category    String?

  // Distinguishes product-supplied system templates from org-created ones.
  isSystem Boolean @default(false)

  // JSON layout blueprint — same structure as Dashboard.layout.
  layout Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isSystem])
  @@map("dashboard_templates")
}

// Stores a named collection of visual design tokens for the dashboard UI.
// Themes are separate from layout — a user can switch themes without affecting
// widget positions, and can switch layouts without affecting their theme.
//
// onDelete behavior:
//   - Organization: Cascade — themes belong to the tenant.
//
// Unique constraint decision:
//   No composite unique on (organizationId, name). Multiple drafts or
//   similarly named themes are allowed; enforced at application layer.
model VisualTheme {
  id             String @id @default(cuid())
  organizationId String

  name      String
  isDefault Boolean @default(false)

  // JSON design-token blob.
  // Example: { mode, primaryColor, secondaryColor, backgroundColor,
  //            cardBackground, borderRadius, fontFamily }
  tokens Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isDefault])
  @@map("visual_themes")
}
