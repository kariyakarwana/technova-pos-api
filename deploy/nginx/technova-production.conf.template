# Replace __DOMAIN__ only after DNS and public ingress are confirmed.
limit_req_zone $binary_remote_addr zone=api_general:20m rate=50r/s;
limit_req_zone $binary_remote_addr zone=authentication:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=ai_operations:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=connections_per_ip:10m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    server_tokens off;
    client_max_body_size 50m;
    limit_conn connections_per_ip 50;
    limit_req_status 429;
    limit_conn_status 429;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "healthy\n";
    }

    location ^~ /api/backend/ {
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/proxy_params;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location ~ ^/api/v1/auth/(login|customer/login|forgot-password|verify-reset-otp|resend-verification)$ {
        limit_req zone=authentication burst=10 nodelay;
        proxy_pass http://127.0.0.1:4000;
        include /etc/nginx/proxy_params;
        proxy_http_version 1.1;
    }

    location ^~ /api/v1/ai-intelligence/ {
        limit_req zone=ai_operations burst=20 nodelay;
        proxy_pass http://127.0.0.1:4000;
        include /etc/nginx/proxy_params;
        proxy_http_version 1.1;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    location /api/v1/ {
        limit_req zone=api_general burst=100 nodelay;
        proxy_pass http://127.0.0.1:4000;
        include /etc/nginx/proxy_params;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location /storage/ {
        proxy_pass http://127.0.0.1:9000/;
        include /etc/nginx/proxy_params;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    location ^~ /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/proxy_params;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/proxy_params;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 60s;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
