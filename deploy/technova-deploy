#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  echo "Usage: technova-deploy FRONTEND BACKEND MIGRATE AI | --frontend IMAGE | --backend BACKEND_IMAGE MIGRATE_IMAGE | --ai IMAGE" >&2
  exit 64
}

readonly DEPLOY_DIR=/opt/technova/deploy
readonly COMPOSE_FILE="$DEPLOY_DIR/compose.production.yml"
readonly SECRET_ENV=/etc/technova/production.env
readonly RELEASE_ENV="$DEPLOY_DIR/release.env"
readonly PREVIOUS_ENV="$DEPLOY_DIR/release.previous.env"
readonly BACKUP_DIR=/var/backups/technova/postgres

readonly FRONTEND_PATTERN='^ghcr\.io/kariyakarwana/technova-pos@sha256:[0-9a-f]{64}$'
readonly BACKEND_PATTERN='^ghcr\.io/kariyakarwana/technova-pos-api@sha256:[0-9a-f]{64}$'
readonly BACKEND_MIGRATE_PATTERN='^ghcr\.io/kariyakarwana/technova-pos-api-migrate@sha256:[0-9a-f]{64}$'
readonly AI_PATTERN='^ghcr\.io/kariyakarwana/technova-pos-ai@sha256:[0-9a-f]{64}$'

validate_image() {
  local value="${1:-}"
  local pattern="$2"
  if [[ ! "$value" =~ $pattern ]]; then
    echo "Rejected invalid image reference: $value" >&2
    exit 65
  fi
}

load_release_env() {
  if [[ ! -f "$RELEASE_ENV" || ! -r "$RELEASE_ENV" ]]; then
    echo "Per-service deployment requires an existing readable release file: $RELEASE_ENV" >&2
    exit 66
  fi

  local existing_frontend=""
  local existing_backend=""
  local existing_migrate=""
  local existing_ai=""
  local line key value

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

    if [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
      key="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"
      if [[ "$value" =~ ^\"(.*)\"$ ]] || [[ "$value" =~ ^\'(.*)\'$ ]]; then
        value="${BASH_REMATCH[1]}"
      fi
      case "$key" in
        FRONTEND_IMAGE) existing_frontend="$value" ;;
        BACKEND_IMAGE) existing_backend="$value" ;;
        BACKEND_MIGRATE_IMAGE) existing_migrate="$value" ;;
        AI_IMAGE) existing_ai="$value" ;;
      esac
    fi
  done < "$RELEASE_ENV"

  case "$mode" in
    frontend)
      BACKEND_IMAGE="$existing_backend"
      BACKEND_MIGRATE_IMAGE="$existing_migrate"
      AI_IMAGE="$existing_ai"
      ;;
    backend)
      FRONTEND_IMAGE="$existing_frontend"
      AI_IMAGE="$existing_ai"
      ;;
    ai)
      FRONTEND_IMAGE="$existing_frontend"
      BACKEND_IMAGE="$existing_backend"
      BACKEND_MIGRATE_IMAGE="$existing_migrate"
      ;;
  esac
}

mode=""
FRONTEND_IMAGE=""
BACKEND_IMAGE=""
BACKEND_MIGRATE_IMAGE=""
AI_IMAGE=""

if [[ "$#" -eq 4 && "$1" != -* ]]; then
  mode="full"
  FRONTEND_IMAGE="$1"
  BACKEND_IMAGE="$2"
  BACKEND_MIGRATE_IMAGE="$3"
  AI_IMAGE="$4"
elif [[ "$#" -eq 2 && "$1" == "--frontend" ]]; then
  mode="frontend"
  FRONTEND_IMAGE="$2"
elif [[ "$#" -eq 3 && "$1" == "--backend" ]]; then
  mode="backend"
  BACKEND_IMAGE="$2"
  BACKEND_MIGRATE_IMAGE="$3"
elif [[ "$#" -eq 2 && "$1" == "--ai" ]]; then
  mode="ai"
  AI_IMAGE="$2"
else
  usage
fi

case "$mode" in
  full)
    validate_image "$FRONTEND_IMAGE" "$FRONTEND_PATTERN"
    validate_image "$BACKEND_IMAGE" "$BACKEND_PATTERN"
    validate_image "$BACKEND_MIGRATE_IMAGE" "$BACKEND_MIGRATE_PATTERN"
    validate_image "$AI_IMAGE" "$AI_PATTERN"
    ;;
  frontend)
    validate_image "$FRONTEND_IMAGE" "$FRONTEND_PATTERN"
    ;;
  backend)
    validate_image "$BACKEND_IMAGE" "$BACKEND_PATTERN"
    validate_image "$BACKEND_MIGRATE_IMAGE" "$BACKEND_MIGRATE_PATTERN"
    ;;
  ai)
    validate_image "$AI_IMAGE" "$AI_PATTERN"
    ;;
esac

exec 9>/run/lock/technova-deploy.lock
if ! flock -w 1800 9; then
  echo "Timed out waiting for deployment lock after 30 minutes" >&2
  exit 75
fi

if [[ "$mode" != "full" ]]; then
  load_release_env
  validate_image "$FRONTEND_IMAGE" "$FRONTEND_PATTERN"
  validate_image "$BACKEND_IMAGE" "$BACKEND_PATTERN"
  validate_image "$BACKEND_MIGRATE_IMAGE" "$BACKEND_MIGRATE_PATTERN"
  validate_image "$AI_IMAGE" "$AI_PATTERN"
fi

readonly FRONTEND_IMAGE
readonly BACKEND_IMAGE
readonly BACKEND_MIGRATE_IMAGE
readonly AI_IMAGE

test -r "$SECRET_ENV"
test -r "$COMPOSE_FILE"
install -d -o root -g root -m 0700 "$BACKUP_DIR"

candidate="$(mktemp "$DEPLOY_DIR/release.candidate.XXXXXX")"
trap 'rm -f "$candidate"' EXIT

cat > "$candidate" <<EOF
FRONTEND_IMAGE=$FRONTEND_IMAGE
BACKEND_IMAGE=$BACKEND_IMAGE
BACKEND_MIGRATE_IMAGE=$BACKEND_MIGRATE_IMAGE
AI_IMAGE=$AI_IMAGE
EOF
chmod 0600 "$candidate"

compose_candidate=(
  docker compose
  --project-name technova-pos-production
  --env-file "$SECRET_ENV"
  --env-file "$candidate"
  -f "$COMPOSE_FILE"
)

"${compose_candidate[@]}" config --quiet
"${compose_candidate[@]}" pull
"${compose_candidate[@]}" up -d --wait postgres

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
if [[ -f "$RELEASE_ENV" ]]; then
  cp --preserve=mode,ownership,timestamps "$RELEASE_ENV" "$PREVIOUS_ENV"
  postgres_user="$("${compose_candidate[@]}" exec -T postgres printenv POSTGRES_USER)"
  postgres_db="$("${compose_candidate[@]}" exec -T postgres printenv POSTGRES_DB)"
  "${compose_candidate[@]}" exec -T postgres \
    pg_dump -U "$postgres_user" -d "$postgres_db" -Fc \
    > "$BACKUP_DIR/pre-deploy-$timestamp.dump"
fi

"${compose_candidate[@]}" run --rm migrate
install -o root -g root -m 0600 "$candidate" "$RELEASE_ENV"

compose_current=(
  docker compose
  --project-name technova-pos-production
  --env-file "$SECRET_ENV"
  --env-file "$RELEASE_ENV"
  -f "$COMPOSE_FILE"
)

"${compose_current[@]}" up -d --remove-orphans

healthy=false
for _attempt in $(seq 1 36); do
  if curl --fail --silent http://127.0.0.1:4000/api/v1/health >/dev/null \
     && curl --fail --silent http://127.0.0.1:3000/login >/dev/null; then
    healthy=true
    break
  fi
  sleep 5
done

if [[ "$healthy" != true ]]; then
  echo "New release failed health checks" >&2
  "${compose_current[@]}" ps >&2 || true
  "${compose_current[@]}" logs --tail=100 backend frontend ai-service >&2 || true

  if [[ -f "$PREVIOUS_ENV" ]]; then
    install -o root -g root -m 0600 "$PREVIOUS_ENV" "$RELEASE_ENV"
    compose_previous=(
      docker compose
      --project-name technova-pos-production
      --env-file "$SECRET_ENV"
      --env-file "$RELEASE_ENV"
      -f "$COMPOSE_FILE"
    )
    "${compose_previous[@]}" pull
    "${compose_previous[@]}" up -d --remove-orphans
    echo "Previous application images restored" >&2
  fi

  echo "Database migrations were not reversed" >&2
  exit 1
fi

"${compose_current[@]}" ps
docker image prune -f --filter 'until=168h' || true
echo "Deployment completed successfully"
