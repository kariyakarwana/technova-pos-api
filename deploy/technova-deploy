#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  echo "Usage: technova-deploy FRONTEND BACKEND MIGRATE AI | --frontend IMAGE | --backend BACKEND_IMAGE MIGRATE_IMAGE | --ai IMAGE" >&2
  exit 64
}

readonly DEPLOY_DIR=/opt/technova/deploy
readonly COMPOSE_FILE="$DEPLOY_DIR/compose.production.yml"
readonly SECRET_ENV=/etc/technova/production.env
readonly RELEASE_ENV="$DEPLOY_DIR/release.env"
readonly PREVIOUS_ENV="$DEPLOY_DIR/release.previous.env"
readonly BACKUP_DIR=/var/backups/technova/postgres
readonly PUBLIC_URL_FILE=/etc/technova/public-base-url

if [[ "${1:-}" == "--version" && "$#" -eq 1 ]]; then
  echo 'technova-deploy 1.0.0'
  exit 0
fi

readonly FRONTEND_PATTERN='^ghcr\.io/kariyakarwana/technova-pos@sha256:[0-9a-f]{64}$'
readonly BACKEND_PATTERN='^ghcr\.io/kariyakarwana/technova-pos-api@sha256:[0-9a-f]{64}$'
readonly BACKEND_MIGRATE_PATTERN='^ghcr\.io/kariyakarwana/technova-pos-api-migrate@sha256:[0-9a-f]{64}$'
readonly AI_PATTERN='^ghcr\.io/kariyakarwana/technova-pos-ai@sha256:[0-9a-f]{64}$'

validate_image() {
  local value="${1:-}"
  local pattern="$2"
  if [[ ! "$value" =~ $pattern ]]; then
    echo "Rejected invalid image reference: $value" >&2
    exit 65
  fi
}

load_release_env() {
  if [[ ! -f "$RELEASE_ENV" || ! -r "$RELEASE_ENV" ]]; then
    echo "Per-service deployment requires an existing readable release file: $RELEASE_ENV" >&2
    exit 66
  fi

  local existing_frontend=""
  local existing_backend=""
  local existing_migrate=""
  local existing_ai=""
  local line key value

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

    if [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
      key="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"
      if [[ "$value" =~ ^\"(.*)\"$ ]] || [[ "$value" =~ ^\'(.*)\'$ ]]; then
        value="${BASH_REMATCH[1]}"
      fi
      case "$key" in
        FRONTEND_IMAGE) existing_frontend="$value" ;;
        BACKEND_IMAGE) existing_backend="$value" ;;
        BACKEND_MIGRATE_IMAGE) existing_migrate="$value" ;;
        AI_IMAGE) existing_ai="$value" ;;
      esac
    fi
  done < "$RELEASE_ENV"

  case "$mode" in
    frontend)
      BACKEND_IMAGE="$existing_backend"
      BACKEND_MIGRATE_IMAGE="$existing_migrate"
      AI_IMAGE="$existing_ai"
      ;;
    backend)
      FRONTEND_IMAGE="$existing_frontend"
      AI_IMAGE="$existing_ai"
      ;;
    ai)
      FRONTEND_IMAGE="$existing_frontend"
      BACKEND_IMAGE="$existing_backend"
      BACKEND_MIGRATE_IMAGE="$existing_migrate"
      ;;
  esac
}

mode=""
FRONTEND_IMAGE=""
BACKEND_IMAGE=""
BACKEND_MIGRATE_IMAGE=""
AI_IMAGE=""

if [[ "$#" -eq 4 && "$1" != -* ]]; then
  mode="full"
  FRONTEND_IMAGE="$1"
  BACKEND_IMAGE="$2"
  BACKEND_MIGRATE_IMAGE="$3"
  AI_IMAGE="$4"
elif [[ "$#" -eq 2 && "$1" == "--frontend" ]]; then
  mode="frontend"
  FRONTEND_IMAGE="$2"
elif [[ "$#" -eq 3 && "$1" == "--backend" ]]; then
  mode="backend"
  BACKEND_IMAGE="$2"
  BACKEND_MIGRATE_IMAGE="$3"
elif [[ "$#" -eq 2 && "$1" == "--ai" ]]; then
  mode="ai"
  AI_IMAGE="$2"
else
  usage
fi

case "$mode" in
  full)
    validate_image "$FRONTEND_IMAGE" "$FRONTEND_PATTERN"
    validate_image "$BACKEND_IMAGE" "$BACKEND_PATTERN"
    validate_image "$BACKEND_MIGRATE_IMAGE" "$BACKEND_MIGRATE_PATTERN"
    validate_image "$AI_IMAGE" "$AI_PATTERN"
    ;;
  frontend)
    validate_image "$FRONTEND_IMAGE" "$FRONTEND_PATTERN"
    ;;
  backend)
    validate_image "$BACKEND_IMAGE" "$BACKEND_PATTERN"
    validate_image "$BACKEND_MIGRATE_IMAGE" "$BACKEND_MIGRATE_PATTERN"
    ;;
  ai)
    validate_image "$AI_IMAGE" "$AI_PATTERN"
    ;;
esac

exec 9>/run/lock/technova-deploy.lock
if ! flock -w 1800 9; then
  echo "Timed out waiting for deployment lock after 30 minutes" >&2
  exit 75
fi

if [[ "$mode" != "full" ]]; then
  load_release_env
  validate_image "$FRONTEND_IMAGE" "$FRONTEND_PATTERN"
  validate_image "$BACKEND_IMAGE" "$BACKEND_PATTERN"
  validate_image "$BACKEND_MIGRATE_IMAGE" "$BACKEND_MIGRATE_PATTERN"
  validate_image "$AI_IMAGE" "$AI_PATTERN"
fi

readonly FRONTEND_IMAGE
readonly BACKEND_IMAGE
readonly BACKEND_MIGRATE_IMAGE
readonly AI_IMAGE

test -r "$SECRET_ENV"
test -r "$COMPOSE_FILE"
test -r "$PUBLIC_URL_FILE"
PUBLIC_BASE_URL="$(cat "$PUBLIC_URL_FILE")"
PUBLIC_BASE_URL="${PUBLIC_BASE_URL%/}"
if [[ ! "$PUBLIC_BASE_URL" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?$ ]]; then
  echo 'A production HTTPS origin is required in /etc/technova/public-base-url' >&2
  exit 65
fi
readonly PUBLIC_BASE_URL
install -d -o root -g root -m 0700 "$BACKUP_DIR"

candidate="$(mktemp "$DEPLOY_DIR/release.candidate.XXXXXX")"
previous_available=false
rollout_started=false
migrations_started=false
committed=false
if [[ -f "$RELEASE_ENV" ]]; then
  cp --preserve=mode,ownership,timestamps "$RELEASE_ENV" "$PREVIOUS_ENV"
  previous_available=true
fi

case "$mode" in
  frontend) services=(frontend); pull_services=(frontend) ;;
  backend) services=(backend); pull_services=(backend migrate) ;;
  ai) services=(ai-service); pull_services=(ai-service) ;;
  full) services=(postgres minio ai-service backend frontend); pull_services=() ;;
esac

health_checks() {
  local -a compose=("$@")
  # Explicitly test AI as well as API/UI. These run under the server lock.
  "${compose[@]}" exec -T ai-service python -c \
    "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=5)" >/dev/null || return 1
  local endpoint
  for endpoint in \
    http://127.0.0.1:4000/api/v1/health \
    http://127.0.0.1:3000/login \
    "$PUBLIC_BASE_URL/nginx-health" \
    "$PUBLIC_BASE_URL/api/v1/health" \
    "$PUBLIC_BASE_URL/login"; do
    curl --fail --silent --show-error --connect-timeout 5 --max-time 15 \
      --retry 3 --retry-delay 3 --retry-all-errors "$endpoint" >/dev/null || return 1
  done
}

finish() {
  local status="$?"
  trap - EXIT INT TERM HUP
  set +e
  if [[ "$status" -ne 0 && "$rollout_started" == true && "$committed" != true ]]; then
    echo 'Deployment failed; recovering previous application images.' >&2
    if [[ "$previous_available" == true ]]; then
      local -a previous=(docker compose --project-name technova-pos-production
        --env-file "$SECRET_ENV" --env-file "$PREVIOUS_ENV" -f "$COMPOSE_FILE")
      local -a rollback_args=(--no-deps)
      [[ "$mode" == full ]] && rollback_args=()
      # Previous images were pre-pulled before mutation; rollback needs no registry access.
      if "${previous[@]}" up -d --wait --wait-timeout 180 "${rollback_args[@]}" "${services[@]}" \
        && health_checks "${previous[@]}"; then
        echo 'Previous application images restored and verified.' >&2
      else
        echo 'CRITICAL: rollback verification failed; operator intervention required.' >&2
      fi
    else
      echo 'No previous release exists; operator intervention required.' >&2
    fi
  fi
  if [[ "$status" -ne 0 && "$migrations_started" == true ]]; then
    echo 'Database migrations are NOT reversed. Use backward-compatible migrations and the verified backup for recovery.' >&2
  fi
  rm -f "$candidate"
  exit "$status"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

cat > "$candidate" <<EOF
FRONTEND_IMAGE=$FRONTEND_IMAGE
BACKEND_IMAGE=$BACKEND_IMAGE
BACKEND_MIGRATE_IMAGE=$BACKEND_MIGRATE_IMAGE
AI_IMAGE=$AI_IMAGE
EOF
chmod 0600 "$candidate"

compose_candidate=(
  docker compose
  --project-name technova-pos-production
  --env-file "$SECRET_ENV"
  --env-file "$candidate"
  -f "$COMPOSE_FILE"
)

"${compose_candidate[@]}" config --quiet
"${compose_candidate[@]}" pull "${pull_services[@]}"
if [[ "$previous_available" == true ]]; then
  # Ensure recovery images remain available locally before changing any running service.
  docker compose --project-name technova-pos-production --env-file "$SECRET_ENV" \
    --env-file "$PREVIOUS_ENV" -f "$COMPOSE_FILE" pull "${pull_services[@]}"
fi
if [[ "$mode" == full ]]; then
  rollout_started=true
  "${compose_candidate[@]}" up -d --wait --wait-timeout 180 postgres
fi

if [[ "$mode" == backend || "$mode" == full ]]; then
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  backup="$BACKUP_DIR/pre-deploy-$timestamp.dump"
  postgres_user="$("${compose_candidate[@]}" exec -T postgres printenv POSTGRES_USER)"
  postgres_db="$("${compose_candidate[@]}" exec -T postgres printenv POSTGRES_DB)"
  umask 077
  "${compose_candidate[@]}" exec -T postgres \
    pg_dump -U "$postgres_user" -d "$postgres_db" -Fc > "$backup"
  test -s "$backup"
  "${compose_candidate[@]}" exec -T postgres pg_restore --list < "$backup" >/dev/null
  migrations_started=true
  "${compose_candidate[@]}" run --rm --no-deps migrate
fi

rollout_started=true
up_args=(--no-deps)
[[ "$mode" == full ]] && up_args=()
"${compose_candidate[@]}" up -d --wait --wait-timeout 180 "${up_args[@]}" "${services[@]}"
health_checks "${compose_candidate[@]}"
"${compose_candidate[@]}" ps
# Commit the release ledger only after the entire acceptance check passes.
# candidate and release.env are on the same filesystem, so rename is atomic.
chown root:root "$candidate"
chmod 0600 "$candidate"
mv -f "$candidate" "$RELEASE_ENV"
committed=true
echo 'Deployment completed successfully'
