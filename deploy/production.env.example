# Private pre-DNS staging values. Replace localhost URLs with the approved
# HTTPS hostname and set AUTH_COOKIE_SECURE=true before public launch.
NODE_ENV=production
PORT=4000
FRONTEND_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
AUTH_COOKIE_SECURE=false

POSTGRES_DB=technova_pos
POSTGRES_USER=technova_app
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD
DATABASE_URL=postgresql://technova_app:REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD@postgres:5432/technova_pos?schema=public

JWT_ACCESS_PRIVATE_KEY=REPLACE_WITH_EXISTING_PRIVATE_KEY
JWT_ACCESS_PUBLIC_KEY=REPLACE_WITH_MATCHING_PUBLIC_KEY
AUTH_OTP_PEPPER=REPLACE_WITH_RANDOM_SECRET

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_CALLBACK_URL=http://localhost:8080/api/v1/auth/microsoft/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_HAS_BODY_PARAMETER=false
WHATSAPP_WEBHOOK_SECRET=
NOTIFICATION_WORKER_ENABLED=true

QR_LABEL_SECRET=REPLACE_WITH_RANDOM_SECRET

MINIO_ROOT_USER=technova-root
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_SECRET
MINIO_ACCESS_KEY=technova-app
MINIO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
MINIO_PUBLIC_BUCKET=technova-public
MINIO_PRIVATE_BUCKET=technova-private
MINIO_PUBLIC_URL=http://localhost:8080/storage

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
AI_SERVICE_URL=http://ai-service:8000

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_RETRY_BASE_DELAY_MS=1000

